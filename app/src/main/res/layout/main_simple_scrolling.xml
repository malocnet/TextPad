<?xml version="1.0" encoding="utf-8"?>

<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/editor_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">

    <include layout="@layout/editor_toolbar" />
    
    <LinearLayout
        android:id="@+id/replace_bar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:padding="4dp"
        android:visibility="gone">

        <EditText
            android:id="@+id/replace_input"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:hint="Replace with..."
            android:inputType="text"
            android:padding="4dp" />

        <Button
            android:id="@+id/btn_replace"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Replace"
            android:textSize="12sp" />

        <Button
            android:id="@+id/btn_replace_all"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="All"
            android:textSize="12sp" />

    </LinearLayout>

    <LinearLayout
        android:id="@+id/linear_layout"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <EditText
            android:id="@+id/editText1"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:autofillHints=""
            android:fadingEdge="none"
            android:gravity="top"
            android:hint="@string/Type_Something_Here"
            android:inputType="text|textAutoComplete|textAutoCorrect"
            android:overScrollMode="ifContentScrolls"
            android:padding="5dip"
            android:saveEnabled="false"
            android:scrollbars="vertical" />
    </LinearLayout>
</LinearLayout>
